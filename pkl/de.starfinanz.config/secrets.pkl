/// Helpers for reading secrets from HashiCorp Vault in a **reproducible** way.
///
/// Versioning is mandatory by construction: every helper here requires an
/// explicit `version`, so Pkl itself refuses to type-check a secret read that
/// does not pin a KV v2 version. This guarantees that rebuilding an old app
/// revision resolves the exact secret revision it shipped with, instead of
/// whatever is latest today.
///
/// Always prefer these helpers over a raw `read("vault:...")`. The pkl-vault
/// reader additionally rejects any unversioned `vault:` URI at evaluation time,
/// so a hand-written raw read without `?version=` fails the build as well.
module de.starfinanz.config.secrets

/// Read a single field of a KV v2 secret at a pinned [version].
///
/// Produces `vault:<mount>/data/<path>?version=<version>#<field>`.
///
/// Example:
/// ```
/// password = vaultField("secret", "myapp/db", 3, "password")
/// ```
function vaultField(mount: String, path: String, version: Int, field: String): String =
  read("vault:\(mount)/data/\(path)?version=\(version)#\(field)").text

/// Read the whole KV v2 secret object (as JSON text) at a pinned [version].
///
/// Produces `vault:<mount>/data/<path>?version=<version>`.
function vaultSecret(mount: String, path: String, version: Int): String =
  read("vault:\(mount)/data/\(path)?version=\(version)").text
